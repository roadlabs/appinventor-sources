{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "App Inventor",
  "version": "0.1.0",
  "identifier": "org.appinventor.offline",
  "build": {
    "frontendDist": "../../offline-webapp"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "App Inventor (Offline)",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
